# Read by docker compose for the `prod` profile only. Dev never needs this file.
# Copy to .env and fill in.

# Required: signs JWTs for every backend instance (they must all share it).
JWT_SECRET=change-me

# Hostname the edge serves. `localhost` → self-signed local CA certificate.
# A real DNS name that resolves to this machine → Let's Encrypt, automatically
# (also remove `tls internal` from edge/Caddyfile).
PUBLIC_HOST=localhost
