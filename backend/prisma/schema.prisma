generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  rooms     Room[]   @relation("RoomOwner")
}

model Room {
  id          String     @id @default(cuid())
  name        String
  description String?
  language    String     @default("python")
  isPublic    Boolean    @default(true)
  ownerId     String?
  owner       User?      @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  snapshots   Snapshot[]

  // Authoritative Yjs document state (a binary CRDT update, not text).
  // Every backend instance rebuilds the room's Y.Doc from exactly these bytes,
  // so their documents merge cleanly instead of duplicating each other's text —
  // which is what seeding separate docs from a plain string would do.
  docState    Bytes?
}

model Snapshot {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}
